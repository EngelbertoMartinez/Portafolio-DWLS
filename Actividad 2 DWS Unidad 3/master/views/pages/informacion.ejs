<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>

    <style>
      .card img {
        height: 200px;
        object-fit: cover;
      }
    </style>
  </head>

  <body>
    <%- include('../includes/header') %>

    <main class="mt-5" style="margin-top: 80px !important">
      <div class="container">

        <h2 class="text-center">Destinos 2026</h2>

        <div class="row mt-4">

          <% destinos.forEach(destino => { %>
            
            <div class="col-md-4 mb-4">
              <div class="card shadow">

                <img src="<%= destino.imagen %>" class="card-img-top">

                <div class="card-body text-center">
                  <h5><%= destino.nombre %></h5>

                  <p><strong>Precio:</strong> $<%= destino.precio %></p>

                  <p>
                    <strong>Dificultad:</strong> 
                    <%= destino.dificultad %>
                  </p>
                </div>

              </div>
            </div>

          <% }) %>

        </div>

      </div>

<div class="text-center mt-5">
  <a href="/perfil" class="btn btn-success btn-lg">
    Planifica tu viaje 🌍
  </a>
</div>

    </main>

    <%- include('../includes/scripts') %>
  </body>
</html>
